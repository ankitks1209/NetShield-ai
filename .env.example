# Copy to .env for Compose, or configure these in your deployment's secret store.
# Generate THREE DIFFERENT secrets: python3 -c 'import secrets; print(secrets.token_hex(32))'
JWT_SECRET_KEY=
POSTGRES_PASSWORD=
MONGO_PASSWORD=
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Empty disables collection. Replay runs ONCE per API process, independently of viewers.
MONITORING_DATASETS=cicids2017
REPLAY_INTERVAL_SECONDS=1
SENSOR_ID=local-sensor
ZEEK_STALE_SECONDS=120
# Set an absolute directory for compose.zeek.yml. Capture runs on the sensor host.
# ZEEK_LOG_DIR=/absolute/path/to/zeek-logs
# Optional HTTPS security webhook; simulations never notify, replay is excluded by default.
SECURITY_WEBHOOK_URL=
NOTIFY_REPLAY=false
# For direct local Python execution, set real connection URLs. Compose sets private URLs.
# DATABASE_URL=postgresql://netshield:<url-encoded-password>@localhost:5432/netshield
# MONGO_URI=mongodb://netshield:<url-encoded-password>@localhost:27017/?authSource=admin
